# ==============================================================================
# AnyClass - Environment Variables (.env)
# ==============================================================================

# Token del tuo Bot Telegram ottenuto da @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCDEF_inserisci_qui_il_tuo_token"

# ID Telegram del proprietario (invia /myid al bot per scoprire il tuo)
# Solo questo ID potrà inviare messaggi ed eseguire i comandi da terminale approvati
TELEGRAM_ALLOWED_USER_ID=""

# Endpoint Ollama System One (predefinito locale)
OLLAMA_ENDPOINT="http://localhost:11434/v1/systemone"

# Modelli decisionali Ollama
DECISION_MODEL_MULTIMODAL="d1-omni:600m"
DECISION_MODEL_TEXT="tev1:0.8b"
